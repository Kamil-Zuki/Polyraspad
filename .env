# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=polyraspad-local-postgres-2026

# MinIO / media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=polyraspad-local-minio-2026
MINIO_PUBLIC_BASE_URL=http://localhost:9000/polyraspad-media
MINIO_SERVER_FETCH_BASE_URL=http://minio:9000/polyraspad-media

# JWT shared by authorization-module and aggregator-service
JWT_SECRET=polyraspad-local-jwt-secret-2026-32chars-min
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=http://localhost:5000

# Email confirmation flow
AUTH_CONFIRMATION_LINK=http://localhost:5000/api/Auth/confirm-email?userId
SMTP_HOST=mail.local
SMTP_PORT=465
SMTP_USERNAME=local-mail-user
SMTP_PASSWORD=local-mail-password
SMTP_ADDRESS=no-reply@local.test
SMTP_DISPLAY_NAME=Polyraspad Local

# Next.js public URLs
# These values are baked into the frontend bundle during docker build.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LANDING_NEXT_PUBLIC_APP_URL=http://localhost:3000
LANDING_NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Aggregator/Auth CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Optional AI proxy
OLLAMA_MODEL=phi3:mini
OLLAMA_PROXY_API_KEY=
