# Postgres (используются в connection strings сервисов)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123

# Next.js public URLs (встраиваются в сборку фронта при docker build)
# Для доступа с хоста после "docker compose up" используйте localhost.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
