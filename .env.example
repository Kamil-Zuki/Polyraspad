# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# MinIO / media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_PUBLIC_BASE_URL=http://localhost:9000/polyraspad-media
MINIO_SERVER_FETCH_BASE_URL=http://minio:9000/polyraspad-media

# JWT shared by authorization-module and aggregator-service
JWT_SECRET=change-me-use-at-least-32-characters-long-secret
JWT_ISSUER=polyraspad.local
JWT_AUDIENCE=polyraspad.local

# Email confirmation flow
# Для почты Beget рекомендуемые параметры:
#   SMTP_HOST=smtp.beget.com
#   SMTP_PORT=2525 (использует STARTTLS, рекомендуется Beget взамен 25/587; 465 не подходит для SmtpClient с EnableSsl=true)
#   SMTP_ADDRESS должен совпадать с SMTP_USERNAME (логином ящика Beget)
AUTH_CONFIRMATION_LINK=http://localhost:5000/api/Auth/confirm-email?userId
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_YOUR_RESEND_API_KEY
SMTP_ADDRESS=noreply@send.polyraspad.online
SMTP_DISPLAY_NAME=Polyraspad

# Next.js public URLs
# These values are baked into the frontend bundle during docker build.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Feature flags (baked at frontend docker build; opt-in with true)
NEXT_PUBLIC_FF_AI_AGENTS=false
NEXT_PUBLIC_FF_ADVANCED_MODULES=false
# Production (landing compose):
LANDING_NEXT_PUBLIC_APP_URL=https://app.polyraspad.online
LANDING_NEXT_PUBLIC_SITE_URL=https://polyraspad.online
# Local landing (docker compose with landing on :3002):
# LANDING_NEXT_PUBLIC_APP_URL=http://localhost:3000
# LANDING_NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Aggregator/Auth CORS (include :3002 when running landing locally)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# ------------------------------------------------------------------------------
# AI / LLM / TTS (server-side on Aggregator) + BFF shared secret for Next /api/ai/*
# ------------------------------------------------------------------------------
#
# Aggregator uses an OpenAI-compatible client. For Mistral, set the base URL to
# https://api.mistral.ai/v1 and use a Mistral model name below.
OPENAI_API_KEY=                         # API key from Mistral (or OpenAI) dashboard
AI_COMPLETION_BASE_URL=https://api.mistral.ai/v1
AI_COMPLETION_MODEL=mistral-large-latest # or mistral-small-latest, codestral-latest, etc.
AI_COMPLETION_ENABLED=true
#
# TTS provider: mistral, openai, espeak, or auto.
# - mistral: requires a real saved Mistral voice_id in AI_TTS_VOICE_ID.
# - espeak: free/offline, bundled in the Aggregator Docker image.
# - auto: picks mistral when BaseUrl contains mistral.ai and a valid voice_id is set,
#         otherwise falls back to espeak (see AggregatorService/Options/TtsProviderHelper.cs).
AI_TTS_PROVIDER=mistral
AI_TTS_MODEL=voxtral-mini-tts-2603
AI_TTS_VOICE_ID=gb_oliver_excited       # real saved Mistral voice_id; OpenAI names like alloy/nova are invalid here
#
# Quick manual check for Mistral TTS (bash; requires curl, jq, base64):
# curl --request POST \
#   --url https://api.mistral.ai/v1/audio/speech \
#   --header "Authorization: Bearer $OPENAI_API_KEY" \
#   --header "Content-Type: application/json" \
#   --data '{"input":"Hi! My name is Kamil. Nice to meet you","model":"voxtral-mini-tts-2603","response_format":"mp3","voice_id":"gb_oliver_excited"}' \
#   | jq -r '.audio_data' | base64 -d > output.mp3
# After confirming a working voice_id, set it as AI_TTS_VOICE_ID and rebuild:
#   docker compose up -d --build aggregator-service
#
# Shared secret between Next.js BFF (/api/ai/*) and Aggregator. MUST be a random string
# (NOT the Mistral/OpenAI API key). Next.js sends it as X-Ai-Proxy-Key.
AI_PROXY_API_KEY=
#
# For compose-frontend: if GEMINI_API_KEY is present without this value, Next.js may switch to Gemini mode.
# EDITOR_AI_PROVIDER=aggregator

# BillingService
BILLING_DEFAULT_PROVIDER=mock
BILLING_GRACE_PERIOD_DAYS=3
BILLING_RENEWAL_POLL_INTERVAL_MINUTES=15
BILLING_WEBHOOK_API_KEY=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/billing/success
YOOKASSA_USE_SANDBOX=true
