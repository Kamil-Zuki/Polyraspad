# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# MinIO / media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_PUBLIC_BASE_URL=http://localhost:9000/polyraspad-media
MINIO_SERVER_FETCH_BASE_URL=http://minio:9000/polyraspad-media

# JWT shared by authorization-module and aggregator-service
JWT_SECRET=change-me-use-at-least-32-characters-long-secret
JWT_ISSUER=polyraspad.local
JWT_AUDIENCE=polyraspad.local

# Email confirmation flow
AUTH_CONFIRMATION_LINK=http://localhost:5000/api/Auth/confirm-email?userId
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=change-me@example.com
SMTP_PASSWORD=change-me-smtp-password
SMTP_ADDRESS=no-reply@example.com
SMTP_DISPLAY_NAME=Polyraspad

# Next.js public URLs
# These values are baked into the frontend bundle during docker build.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LANDING_NEXT_PUBLIC_APP_URL=https://app.polyraspad.online
LANDING_NEXT_PUBLIC_SITE_URL=https://polyraspad.online

# Aggregator/Auth CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OpenAI-compatible LLM (server-side on Aggregator) + BFF shared secret for Next /api/ai/*
OPENAI_API_KEY=
AI_COMPLETION_BASE_URL=https://api.openai.com/v1
AI_COMPLETION_MODEL=gpt-4o-mini
AI_COMPLETION_ENABLED=true
# TTS (Generate audio in Reader/Editor, Create card). Aggregator image includes espeak-ng.
#
# Вариант A — Docker/local без Mistral voice_id (рекомендуется):
AI_TTS_PROVIDER=espeak
AI_TTS_MODEL=tts-1
AI_TTS_VOICE_ID=
#
# Вариант B — Mistral TTS (тот же ключ, что OPENAI_API_KEY, если LLM на api.mistral.ai):
# AI_TTS_PROVIDER=mistral
# AI_TTS_MODEL=voxtral-mini-tts-2603
# AI_TTS_VOICE_ID=gb_oliver_excited
# OpenAI-имена (alloy, nova, …) и placeholder neutral_female — не валидные Mistral voice_id.
#
# Проверка Mistral TTS вручную (bash; curl, jq, base64):
# curl --request POST \
#   --url https://api.mistral.ai/v1/audio/speech \
#   --header "Authorization: Bearer $OPENAI_API_KEY" \
#   --header "Content-Type: application/json" \
#   --data '{"input":"Hi! My name is Kamil. Nice to meet you","model":"voxtral-mini-tts-2603","response_format":"mp3","voice_id":"gb_oliver_excited"}' \
#   | jq -r '.audio_data' | base64 -d > output.mp3
# Рабочий voice_id из ответа → AI_TTS_VOICE_ID, затем: docker compose up -d --build aggregator-service
#
# auto: Mistral LLM URL + AI_TTS_VOICE_ID задан → mistral; иначе espeak (см. AggregatorService/Options/TtsProviderHelper.cs).
# Обязательно задать одну и ту же случайную строку (не ключ Mistral/OpenAI): Next шлёт её в Aggregator, иначе список моделей и /api/ai не работают.
AI_PROXY_API_KEY=
# Для compose-frontend: при наличии GEMINI_API_KEY в этом файле без этого значения Next мог бы уйти в режим Gemini.
# EDITOR_AI_PROVIDER=aggregator
