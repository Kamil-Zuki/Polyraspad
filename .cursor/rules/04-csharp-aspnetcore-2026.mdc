### Async/Await

```csharp
// Возвращаем Task<T> для асинхронных методов
public async Task<TermDto> GetTermAsync(int id)
{
    var term = await _repository.GetByIdAsync(id);
    return _mapper.Map<TermDto>(term);
}

// ConfigureAwait не нужен в ASP.NET Core (SynchronizationContext = null)
// НЕ делайте: await Task.Delay(100).ConfigureAwait(false)
```

### Pattern Matching

```csharp
// Modern pattern matching
public string GetStatusColor(TermStatus status) => status switch
{
    TermStatus.New => "blue",
    TermStatus.Lingq => "yellow",
    TermStatus.Known => "white",
    TermStatus.Ignored => "muted",
    _ => throw new ArgumentOutOfRangeException(nameof(status))
};

// Property patterns
if (term is { Type: TermType.Phrase, Text.Length: > 5 })
{
    // длинная фраза
}
```

## ASP.NET Core архитектура

### Controller-based APIs (основной стиль)

```csharp
var builder = WebApplication.CreateBuilder(args);
builder.Services.AddControllers();
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddSwaggerGen();

var app = builder.Build();

if (app.Environment.IsDevelopment())
{
    app.UseSwagger();
    app.UseSwaggerUI();
}

app.UseHttpsRedirection();
app.UseAuthorization();
app.MapControllers();
app.Run();
```

```csharp
[ApiController]
[Route("api/[controller]")]
public class TermsController : ControllerBase
{
    [HttpGet("{id:int}")]
    [ProducesResponseType<TermDto>(StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status404NotFound)]
    public async Task<ActionResult<TermDto>> GetById(int id, [FromServices] ITermService service)
    {
        var term = await service.GetByIdAsync(id);
        return term is null ? NotFound() : Ok(term);
    }
}
```

### DI и Typed HttpClient

```csharp
// Typed client для внешних API
builder.Services.AddHttpClient<ITranslationService, TranslationService>(client =>
{
    client.BaseAddress = new Uri("https://api.translator.com/");
    client.DefaultRequestHeaders.Add("Accept", "application/json");
});

// Полит resilience с Polly
builder.Services.AddHttpClient("resilient")
    .AddTransientHttpErrorPolicy(policy =>
        policy.WaitAndRetryAsync(3, retryAttempt =>
            TimeSpan.FromSeconds(Math.Pow(2, retryAttempt))));
```

### Options Pattern

```csharp
// Конфигурация
public class TranslationOptions
{
    public required string ApiKey { get; set; }
    public int TimeoutSeconds { get; set; } = 30;
}

// Регистрация
builder.Services.Configure<TranslationOptions>(
    builder.Configuration.GetSection("Translation"));

// Использование
public class TranslationService
{
    private readonly TranslationOptions _options;
    
    public TranslationService(IOptions<TranslationOptions> options)
    {
        _options = options.Value;
    }
}
```

### Validation

```csharp
// FluentValidation (рекомендуется)
public class CreateTermRequestValidator : AbstractValidator<CreateTermRequest>
{
    public CreateTermRequestValidator()
    {
        RuleFor(x => x.Text).NotEmpty().MaximumLength(200);
        RuleFor(x => x.ProjectId).GreaterThan(0);
    }
}

// Data Annotations (для простых случаев)
public class CreateTermRequest
{
    [Required, StringLength(200)]
    public required string Text { get; set; }
    
    [Range(1, int.MaxValue)]
    public int ProjectId { get; set; }
}
```

## Тестирование

### Integration Tests с WebApplicationFactory

```csharp
public class TermsApiTests : IClassFixture<WebApplicationFactory<Program>>
{
    private readonly WebApplicationFactory<Program> _factory;
    private readonly HttpClient _client;

    public TermsApiTests(WebApplicationFactory<Program> factory)
    {
        _factory = factory;
        _client = factory.CreateClient();
    }

    [Theory]
    [InlineData("/api/terms")]
    [InlineData("/api/terms/1")]
    public async Task Get_EndpointsReturnSuccess(string url)
    {
        var response = await _client.GetAsync(url);
        response.EnsureSuccessStatusCode();
    }
}
```

### Unit Tests (xUnit v3)

```csharp
public class TermServiceTests
{
    [Fact]
    public void NormalizeText_TrimsAndLowercases()
    {
        var result = TermService.NormalizeText("  Hello World  ");
        Assert.Equal("hello world", result);
    }

    [Theory]
    [InlineData("sleep", "slept")]
    [InlineData("go", "went")]
    public void DifferentForms_AreNotDuplicates(string form1, string form2)
    {
        var norm1 = TermService.NormalizeText(form1);
        var norm2 = TermService.NormalizeText(form2);
        Assert.NotEqual(norm1, norm2);
    }
}
```

## GRPC

```csharp
// Протокол
service TermService {
    rpc GetTerm (GetTermRequest) returns (TermDto);
    rpc CreateTerm (CreateTermRequest) returns (TermDto);
}

// Реализация
public class TermGrpcService : TermService.TermServiceBase
{
    private readonly ITermService _termService;
    
    public TermGrpcService(ITermService termService)
    {
        _termService = termService;
    }
    
    public override async Task<TermDto> GetTerm(
        GetTermRequest request, 
        ServerCallContext context)
    {
        var term = await _termService.GetByIdAsync(request.Id);
        return _mapper.Map<TermDto>(term);
    }
}
```

## Рекомендации

1. **Всегда включайте nullable reference types** — `#nullable enable`
2. **Используйте records для DTO** — иммутабельность и value equality
3. **Typed HttpClient для внешних API** — чёткие контракты и тестируемость
4. **Options pattern для конфигурации** — валидация на старте
5. **Integration tests для API contracts** — WebApplicationFactory
6. **Миграции — с сохранением данных** — никаких destructive миграций без плана
7. **Для внешних библиотек/фреймворков используйте MCP `context7` из `.cursor`** — не опирайтесь только на память модели
